.PROGRAM LogOF

.DESCRIPTION

.INPUTS

    class OF

.VARIABLES

.RETURN_TYPE none

.BODY
// * * * * * * * * * * * * * * *
// Module:
// Description:
// * * * * * * * * * * * * * * *
print("Nombre d'OFs",arraySize(OF.ROWS))

for (i = 0  ; i < arraySize(OF.ROWS) ; i+=1)
    print("ID",OF.ROWS[i].Id,"Gamme",OF.ROWS[i].Gamme,"LotSize",OF.ROWS[i].LotSize)
end

return
.END

.PROGRAM LogGamme

.DESCRIPTION

.INPUTS

    class Gamme

.VARIABLES

.RETURN_TYPE none

.BODY
// * * * * * * * * * * * * * * *
// Module:
// Description:
// * * * * * * * * * * * * * * *
print("Nombre de lignes dans Gamme",arraySize(Gamme.ROWS))

for (i = 0  ; i < arraySize(Gamme.ROWS) ; i+=1)
    print("Gamme",Gamme.ROWS[i].Gamme,"Nom gamme",Gamme.ROWS[i].NomGamme,"Phase",Gamme.ROWS[i].Phase,"Pos X",Gamme.ROWS[i].PosX,"Pos Y",Gamme.ROWS[i].PosY,"Alpha",Gamme.ROWS[i].Alpha,"Part",Gamme.ROWS[i].Part,"Nom Piece",Gamme.ROWS[i].NomPiece,"Dents",Gamme.ROWS[i].Dents,"Diam Int",Gamme.ROWS[i].DiamInt,"Marquage",Gamme.ROWS[i].Marquage)
end

return
.END

.PROGRAM ExecuteAssembly

.DESCRIPTION

.INPUTS

    class Operation

.VARIABLES

.RETURN_TYPE none

.BODY
// * * * * * * * * * * * * * * *
// Module:
// Description:
// * * * * * * * * * * * * * * *
print("Execute Assembly",Operation.Gamme)

CycleGoupille(Operation)
ToolChange("Tool_MOD_P2Cam")
move(gcPosScanPalette1)
CycleEngrenage(Operation)
ToolChange("Tool_MOD_P2Cam")
move(gcPosScanPalette1)
CycleRondelle(Operation)
ToolChange("Tool_MOD_P2Cam")
move(gcPosScanPalette1)
//CycleScanCapteur

return
.END

.PROGRAM CycleEngrenage

.DESCRIPTION

.INPUTS

    class Operation

.VARIABLES

    locc PositionDepose

.RETURN_TYPE none

.BODY
// * * * * * * * * * * * * * * *
// Module:
// Description:
// * * * * * * * * * * * * * * *
print("Cycle d'engrenage")
ToolChange("Tool_MOD_P2Vacuum")
PositionDepose=OriginePaletteDepose+trans(StrToInt(Operation.PosY),StrToInt(Operation.PosX),-3.5)
//FrameOrigineOK = SelectionPalette()
WaitEndMove()
delay(2)
switch (StrToInt(Operation.Dents))
case 15
    InspectionENGR15()
    delay(2)
    print("Prise Engrenage 15",Operation.Dents)
    PriseDeposeEngr(gcPositionEngr15,TRUE)//gcPositionEngr15

case 18
    InspectionENGR18()
    delay(2)
    print("Prise Engrenage 18",Operation.Dents)
    PriseDeposeEngr(gcPositionEngr18,TRUE)

case 25
    InspectionENGR25()
    delay(2)
    print("Prise Engrenage 25",Operation.Dents)
    PriseDeposeEngr(gcPositionEngr25,TRUE)

case 30
    InspectionENGR30()
    delay(2)
    print("Prise Engrenage 30",Operation.Dents)
    PriseDeposeEngr(gcPositionEngr30,TRUE)
end

print("Dépose Engrenage "+Operation.Dents,Operation.Dents)
PriseDeposeEngr(PositionDepose,FALSE) //gcPositionDepose

return
.END

.PROGRAM CycleGoupille

.DESCRIPTION

.INPUTS

    class Operation

.VARIABLES

    locc PositionDepose

.RETURN_TYPE none

.BODY
// * * * * * * * * * * * * * * *
// Module:
// Description:
// * * * * * * * * * * * * * * *
print("Cycle goupille")
ToolChange("Tool_MOD_P2Pince")
PositionDepose=OriginePaletteDepose+trans(StrToInt(Operation.PosY),StrToInt(Operation.PosX),-1)

delay(2)
InspectionGoup()
delay(2)

print("Prise goupille")
PriseDeposeGoup(gcPositionPickGoup,TRUE)

print("Depose goupille")
PriseDeposeGoup(PositionDepose,FALSE)

return
.END

.PROGRAM CycleRondelle

.DESCRIPTION

.INPUTS

    class Operation

.VARIABLES

    locc PositionDepose

.RETURN_TYPE none

.BODY
// * * * * * * * * * * * * * * *
// Module:
// Description:
// * * * * * * * * * * * * * * *
print("Cycle rondelle")
ToolChange("Tool_MOD_P2Vacuum")
PositionDepose=OriginePaletteDepose+trans(StrToInt(Operation.PosY),StrToInt(Operation.PosX),-3.8)

delay(1)
InspectionRond()
delay(1)

print("Prise rondelle")
PriseDeposeRond(gcPositionPickRond,TRUE)

print("Depose rondelle")
PriseDeposeRond(PositionDepose,FALSE)

return
.END

