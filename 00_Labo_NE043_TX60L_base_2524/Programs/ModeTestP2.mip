.PROGRAM PriseDeposeEngr

.DESCRIPTION

.INPUTS

    locc Position
    bool Prise

.VARIABLES

    real DecalageZ2 = 30

.RETURN_TYPE none

.BODY
// * * * * * * * * * * * * * * *
// Module:
// Description:
// * * * * * * * * * * * * * * *

ToolChange("Tool_MOD_P2Vacuum")
move(Position,DecalageZ2)
setSpeed(1)
moves(Position)
waitEndMove()
ioWrite("brasValve2", Prise)
delay(1)
//if (PartName!="")
//  M3D_AsmObjectToggle(PartName,Index,Prise)
//end
moves(Position,DecalageZ2)
setSpeed(10)
return
.END

