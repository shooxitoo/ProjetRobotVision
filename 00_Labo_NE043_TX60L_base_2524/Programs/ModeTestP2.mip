.PROGRAM SHUTDOWN

.DESCRIPTION

.INPUTS

.VARIABLES

.RETURN_TYPE none

.BODY
// * * * * * * * * * * * * * * *
// Module:
// Description:
// * * * * * * * * * * * * * * *
TaskRobotSTOP()
TaskMainSTOP()

return
.END

.PROGRAM TaskRobotSTART

.DESCRIPTION

.INPUTS

.VARIABLES

.RETURN_TYPE none

.BODY
// * * * * * * * * * * * * * * *
// Module:
// Description:
// * * * * * * * * * * * * * * *
if (!taskExists(gTaskRobotName))
    taskExecute MachineDEtat(), gTaskRobotName
end

return
.END

.PROGRAM TaskRobotSTOP

.DESCRIPTION

.INPUTS

.VARIABLES

.RETURN_TYPE none

.BODY
// * * * * * * * * * * * * * * *
// Module:
// Description:
// * * * * * * * * * * * * * * *
if (taskExists(gTaskRobotName))
    taskStop(gTaskRobotName)
end

return
.END

