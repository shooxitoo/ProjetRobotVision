.PROGRAM LogOF

.DESCRIPTION

.INPUTS

    class OF

.VARIABLES

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Affiche dans la console le contenu de la table OFs,
//                Donne un aperçu complet de la gamme et taille de lot.
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

print("Nombre d'OFs",arraySize(OF.ROWS))

// Boucle pour log chaque ligne de la table "OFs"
for (i = 0  ; i < arraySize(OF.ROWS) ; i+=1)
    print("ID",OF.ROWS[i].Id,"Gamme",OF.ROWS[i].Gamme,"LotSize",OF.ROWS[i].LotSize)
end

return
.END

.PROGRAM LogGamme

.DESCRIPTION

.INPUTS

    class Gamme

.VARIABLES

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Affiche dans la console le contenu de la vue gamme,
//                Donne un aperçu complet des phases, positions,
//                pièces et caractéristiques.
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

print("Nombre de lignes dans Gamme",arraySize(Gamme.ROWS))

// Boucle pour log chaque ligne de la table "OFs"
for (i = 0  ; i < arraySize(Gamme.ROWS) ; i+=1)
    print("Gamme",Gamme.ROWS[i].Gamme,"Nom gamme",Gamme.ROWS[i].NomGamme,"Phase",Gamme.ROWS[i].Phase,"Pos X",Gamme.ROWS[i].PosX,"Pos Y",Gamme.ROWS[i].PosY,"Alpha",Gamme.ROWS[i].Alpha,"Part",Gamme.ROWS[i].Part,"Nom Piece",Gamme.ROWS[i].NomPiece,"Dents",Gamme.ROWS[i].Dents,"Diam Int",Gamme.ROWS[i].DiamInt,"Marquage",Gamme.ROWS[i].Marquage)
end

return
.END

.PROGRAM ExecuteAssembly

.DESCRIPTION

.INPUTS

    class Operation

.VARIABLES

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Exécute la séquence complète d'assemblage.
//                enchaînant les cycles de goupille, engrenage, contrôle via capteur,
//                rondelle, avec les changements d'outil (P2Cam) pour retour en position de scan.
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Execution des différents cycle pour la réalisation complète du montage
print("Execute Assembly",Operation.Gamme) // Print de l'assemblage de la gamme: "Operation.Gamme"

CycleGoupille(Operation) // Cycle goupille
ToolChange("Tool_MOD_P2Cam") // Changement d'outil vers "Tool_Mod_P2Cam"
move(gcPosScanPalette1) // Déplacement en position de scan de la palette

CycleEngrenage(Operation) // Cycle rondelle
ToolChange("Tool_MOD_P2Cam")
move(gcPosScanPalette1)

//CycleScanCapteur() // Cycle capteur
//ToolChange("Tool_MOD_P2Capteur")
//move(gcPosScanPalette1)

CycleRondelle(Operation) // Cycle rondelle
ToolChange("Tool_MOD_P2Cam")
move(gcPosScanPalette1)

return
.END

.PROGRAM CycleEngrenage

.DESCRIPTION

.INPUTS

    class Operation

.VARIABLES

    locc PositionDepose

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Exécute le cycle de manipulation des engrenages.
//                - Changement d'outil (Vacuum)
//                - Détermination de la position de dépose
//                - Inspection de l'engrenage nécessaire défini par la DB
//                - Prise et dépose via PriseDeposeEngr()
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Prépare le tool et la position de depose en fonction des coordonnées X-Y
// reçues de la DB
print("Cycle d'engrenage")
ToolChange("Tool_MOD_P2Vacuum")
PositionDepose=OriginePaletteDepose+trans(StrToInt(Operation.PosY),StrToInt(Operation.PosX),-3.5)
WaitEndMove()
delay(2)

// Switch pour executer l'inspection de l'engrenage nécessaire (en fonction de la DB)
switch (StrToInt(Operation.Dents))
case 15
    InspectionENGR15()
    delay(2)
    print("Prise Engrenage 15",Operation.Dents)
    PriseDeposeEngr(gcPositionEngr15,TRUE) // Pick de l'engrenage 15
    NombreEngrenage15+=1 // Incrémente pour KPI
case 18
    InspectionENGR18()
    delay(2)
    print("Prise Engrenage 18",Operation.Dents)
    PriseDeposeEngr(gcPositionEngr18,TRUE) // Pick de l'engrenage 18
    NombreEngrenage18+=1 // Incrémente pour KPI

case 25
    InspectionENGR25()
    delay(2)
    print("Prise Engrenage 25",Operation.Dents)
    PriseDeposeEngr(gcPositionEngr25,TRUE) // Pick de l'engrenage 25
    NombreEngrenage25+=1 // Incrémente pour KPI

case 30
    InspectionENGR30()
    delay(2)
    print("Prise Engrenage 30",Operation.Dents)
    PriseDeposeEngr(gcPositionEngr30,TRUE) // Pick de l'engrenage 30
    NombreEngrenage30+=1 // Incrémente pour KPI
end

print("Dépose Engrenage "+Operation.Dents,Operation.Dents)
PriseDeposeEngr(PositionDepose,FALSE) // Place des engrenages

return
.END

.PROGRAM CycleGoupille

.DESCRIPTION

.INPUTS

    class Operation

.VARIABLES

    locc PositionDepose

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Exécute le cycle de manipulation d'une goupille.
//                - Changement d'outil (Pince)
//                - Détermination de la position de dépose
//                - Inspection de la goupille via InspectionGoup()
//                - Prise et dépose via PriseDeposeGoup()
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Prépare le tool et la position de depose en fonction des coordonnées X-Y
// reçues de la DB
print("Cycle goupille")
ToolChange("Tool_MOD_P2Pince")
PositionDepose=OriginePaletteDepose+trans(StrToInt(Operation.PosY),StrToInt(Operation.PosX),-1) //-1 Correspont à la hauteur en Z pour la dépose

// Execute l'inspection avec des delay avant et après la prise d'image
delay(2)
InspectionGoup()
delay(2)

// Execute le pick and place de la rondelle
print("Prise goupille")
PriseDeposeGoup(gcPositionPickGoup,TRUE)
NombreGoupilles+=1 // Incrémente le nombre de rondelles pour KPI

print("Depose goupille")
PriseDeposeGoup(PositionDepose,FALSE)

return
.END

.PROGRAM CycleRondelle

.DESCRIPTION

.INPUTS

    class Operation

.VARIABLES

    locc PositionDepose

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Exécute le cycle de manipulation d’une rondelle.
//                - Changement d’outil (Vacuum)
//                - Détermination de la position de dépose
//                - Inspection de la rondelle via InspectionRond()
//                - Prise et dépose via PriseDeposeRond()
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Prépare le tool et la position de depose en fonction des coordonnées X-Y
// reçues de la DB
print("Cycle rondelle")
ToolChange("Tool_MOD_P2Vacuum")
PositionDepose=OriginePaletteDepose+trans(StrToInt(Operation.PosY),StrToInt(Operation.PosX),-3.8) // -3.8 Correspont à la hauteur en Z pour la dépose
//                                                                                                   prenant en compte l'hauteur d'un engrenage
// Execute l'inspection avec des delay avant et après la prise d'image
delay(1)
InspectionRond()
delay(1)

// Execute le pick and place de la rondelle
print("Prise rondelle")
PriseDeposeRond(gcPositionPickRond,TRUE)
NombreRondelles+=1 // Incrémente le nombre de rondelles pour KPI

print("Depose rondelle")
PriseDeposeRond(PositionDepose,FALSE)

return
.END

.PROGRAM ToolChange

.DESCRIPTION

.INPUTS

    string Outil

.VARIABLES

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Change l'outil actif du robot selon la variable Outil
//                en utilisant setTool() avec machineTool(Outil).
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Permet le changement d'outil du robot
print("Changement d'outil ",Outil)
setTool(machineTool(Outil))

return
.END

.PROGRAM ComputeOrigins

.DESCRIPTION

.INPUTS

.VARIABLES

    real OffsetPrise1 = -17.5, OffsetDeposeX = -15, OffsetDeposeY = 10

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Calcule les positions d’origine pour les palettes
//                de prise et de dépose, applique un offset de
//                translation pour aligner les repères du robot
//                avec ceux utilisés par Matrox (vision).
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Création des frames pour "PalettePrise1", "PalettePrise2", "PaletteDepose"
OriginePalettePrise1=frameCompose(gcOriginPalettePrise,gcPosPriseX,gcPosPriseY)+trans(OffsetPrise1,0,0)
//OriginePalettePrise2=frameCompose(gcOriginPalettePrise2,PosPriseX2,PosPriseY2)
OriginePaletteDepose=frameCompose(gcOriginPaletteDepose,gcPosDeposeX,gcPosDeposeY)+trans(OffsetDeposeX,OffsetDeposeY,0)
return
.END

.PROGRAM SelectionPalette

.DESCRIPTION

.INPUTS

    locc Frame
    string Request

.VARIABLES

.RETURN_TYPE locc

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Déplace le robot pour scanner la palette 1.
//                Si la réponse Matrox est négative (NACK), tente palette 2.
//                Retourne l'origine de prise associée si un ACK est reçu.
//                Appelle Erreur() si aucun engrenage n'est détecté. (Pas utilisé pour l'instant)
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Déplacement vers la position de scan de la palette 1
move(gcPosScanPalette1)
print("Scan palette 1")

// Envoi de la requête Matrox pour détection sur palette 1
if (SendMatrox(Request))
    print("ACK reçu de la palette 1")
    return OriginePalettePrise1
else
    print("NACK palette 1 Essai palette 2") // NACK, on tente sur la palette 2
end

// Déplacement vers la position de scan de la palette 2
//moves(PosScanPalette2)
//print("Scan palette 2")
//if (SendMatrox(Request))
//  print("ACK reçu de la palette 2")
//  return OriginePalettePrise2
//else
//  // Aucune pièce détectée sur aucune des palettes
//  print("NACK palette 2 également : engrenage non trouvé")
//  Erreur()
//end

.END

