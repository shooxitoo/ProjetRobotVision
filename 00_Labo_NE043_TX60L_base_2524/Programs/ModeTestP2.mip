.END

.PROGRAM ComputeOrigins

.DESCRIPTION

.INPUTS

.VARIABLES

.RETURN_TYPE none

.BODY
// * * * * * * * * * * * * * * *
// Module:
// Description:
// * * * * * * * * * * * * * * *

OriginePalettePrise1=frameCompose(gcOriginPalettePrise,gcPosPriseX,gcPosPriseY)+trans(-17.5,0,0)
//OriginePalettePrise2=frameCompose(gcOriginPalettePrise2,PosPriseX2,PosPriseY2)
OriginePaletteDepose=frameCompose(gcOriginPaletteDepose,gcPosDeposeX,gcPosDeposeY)+trans(-15,10,0)
return
.END

.PROGRAM SelectionPalette

.DESCRIPTION

.INPUTS

    locc Frame
    string Request

.VARIABLES

.RETURN_TYPE none

.BODY
// * * * * * * * * * * * * * * *
// Module:
// Description:
// * * * * * * * * * * * * * * *

move(PosScanPalette1)
print("Scan palette 1")

if (SendMatrox(Request))
    print("ACK reçu de la palette 1")
    return OriginePalettePrise1
end
print("NACK palette 1 Essai palette 2")

move(PosScanPalette2)
print("Scan palette 2")
if (SendMatrox(Request))
    print("ACK reçu de la palette 2")
    return OriginePalettePrise2
end

print("NACK palette 2 également : engrenage non trouvé")
Erreur()
return
.END

