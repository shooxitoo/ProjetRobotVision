.MODULE_BEGIN ProgP2

.MODULE_VERSION 1.0

.MODULE_DESCRIPTION

.MODULE_PROGRAMS

.PROGRAM ReadMe

.DESCRIPTION

.INPUTS

.VARIABLES

.RETURN_TYPE none

.BODY
// ******************************************************
// README – PROJET P2
// Cellule Robotisée – Vision + SQL
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************
//
// ******************************************************
// SECTION 0 - MODULES DU PROJET
// ******************************************************
// ProgP2: Contient toute la programmation du projet.
// P2Data: Contient de la Data lié au projet notamment un class d'états
//         pour la machine d'états
//
// ******************************************************
// SECTION 1 – OBJECTIF DU PROJET
// ******************************************************
// Ce projet contrôle une cellule robotisée capable d’assembler
// des pièces mécaniques (goupilles, engrenages, rondelles) à
// partir d'ordres de fabrication stockés dans une base SQL,
// en s’appuyant sur la vision Matrox pour détecter les positions réelles.
// tout en inscrivant chaque étape dans un journal SQL.
//
// ******************************************************
// SECTION 2 – ARCHITECTURE
// ******************************************************
// TÂCHES PRINCIPALES :
//  - MainP2()          : surveille et redémarre la tache Robot.
//  - MachineDEtat()    : Machine d'etat qui gère l'init, le stop et le run.
//  - CMDInit / CMDRobotRun / CMDStop : contrôles via fenetre floating
//
// PROGRAMMES MAJEURS :
//  - Mouvements()            : boucle complète OF -> lot -> gamme
//  - ExecuteAssembly()       : execute le cycle d'assemblage via
//                              les sous-programmes suivants:
//  - CycleGoupille(), CycleEngrenage(), CycleRondelle()
//  - DBReadOF(), DBReadGamme(), DBWriteJournal()
//  - Communication vision : SendMatrox()
//  - Communication SQL : DBQuery(), DBExecute()
//
// ******************************************************
// SECTION 3 – POSITIONS ET REPÈRES À RENSEIGNER MANUELLEMENT
// ******************************************************
// Pour que le projet fonctionne correctement et que les coordonnées vision (Matrox)
// soient correctement interprétées par le robot, l'utilisateur doit renseigner ou
// recalibrer manuellement les points suivants dans l’environnement robot :
//
//  REPÈRES À APPRENDRE (dans l’environnement robot, avec axe Z vers le bas) :
//   - OriginePalettePrise1  : position d'origine de prise sur la palette 1
//   - OriginePaletteDepose  : position d'origine de dépose sur la palette de sortie
//    Ces repères doivent être appris avec les coordonnées PosX et PosY définies,
//    et un axe Z orienté vers le bas pour que les prises soient correctes.
//
//  DÉCALAGES DÉFINIS (utilisés dans ComputeOrigins) :
//   - gcPosPriseX, gcPosPriseY   -> coordonnées XY relatives à la palette prise
//   - gcPosDeposeX, gcPosDeposeY -> coordonnées XY relatives à la palette dépose
//
//  RÔLE DES OFFSETS :
//   - OffsetPrise1, OffsetDeposeX, OffsetDeposeY permettent d’ajuster la position
//     calculée pour qu’elle corresponde précisément au référentiel de la vision (Matrox).
//   - Ils compensent les écarts entre le repère robot et le repère utilisé par la caméra,
//     afin de récupérer et interpréter correctement les coordonnées transmises par Matrox.
//
// ******************************************************
// SECTION 4 – DÉMARRAGE DU SYSTÈME
// ******************************************************
// 1. Lancer la tâche principal via "STARTUP" ou floating: "STARTUP"
// 2. Exécuter "CMDInit()" ou floating: "Run" pour :
//      - Initialiser le robot
//      - Calculer les origines via "ComputeOrigins()"
//      - Vérifier les connexions SQL et Matrox
// 3. Démarrer le traitement automatique avec "CMDRun()" ou floating: "Run"
// 4. Arrêter proprement avec "CMDStop()" ou floating: "Stop"
// 5. Puis mettre fin au taches via "SHUTDOWN" ou floating: "SHUTDOWN"
//
// ******************************************************
// SECTION 5 – CYCLE DE PRODUCTION
// ******************************************************
//  Mouvements()
//    - Lit tous les OFs (DBReadOF)
//    - Pour chaque OF : lit la gamme (DBReadGamme)
//    - Pour chaque unité du lot :
//        - Pour chaque phase :
//            - ExecuteAssembly(Operation)
//            - DBWriteJournal(Temps) renseigne dans table SQL "JournalDeTest"
//              l'étape réalisée.
//
//  ExecuteAssembly()
//    - Enchaîne : CycleGoupille() -> CycleEngrenage() -> CycleRondelle()
//    - À chaque étape : changement d’outil, inspection Matrox, prise, dépose
//
// ******************************************************
// SECTION 6 – STRUCTURE SQL ATTENDUE
// ******************************************************
// Tables requises sur le serveur SQL :
//  - OFs              : contient les ordres de fabrication (Id, LotSize, Gamme)
//  - Gammes           : contient les gammes (Id, Nom)
//  - Operations       : contient les étapes (Gamme, Phase, PosX, PosY, Part)
//  - Engrenages       : données techniques associées à Part
//  - Journal          : journalisation des étapes exécutées
//
// Communication SQL via :
//  - dbcQuery()
//  - dbcExecute()
//
// ******************************************************
// SECTION 7 – PROTOCOLE DE VISION (MATROX/RSVP)
// ******************************************************
// Toutes les lectures Matrox utilisent le protocole RSVP :
// - RsClear()         : vide les buffers
// - RsCreateRequest() : crée une commande (ex : "INSPECT_ENGR15")
// - SendMatrox(...)   : envoie la requête et attend "ACK"
// - RsReadDouble()    : lecture X / Y d’objet
// - RsReadInt()       : lecture DataMatrix ou nombre d'engrenages
//
// Requêtes Matrox typiques :
// - INSPECT_ENGR15 -> engrenage taille 15
// - INSPECT_ROND   -> rondelle
// - INSPECT_GOUP   -> goupille
// - INSPECT_NBENGR -> nombre d’engrenages sur la réglette
//
// ******************************************************
// SECTION 8 – COMPÉTENCES REQUISES POUR MAINTENANCE
// ******************************************************
//  Maîtrise de :
//  - Structures de données : tableaux, index, enchaînement d’étapes
//  - Fonctionnement des tâches robotisées (TaskExists, TaskExecute, etc.)
//  - Lecture / écriture en base SQL via le code
//  - Interfaçage RSVP avec Matrox (décodage des requêtes)
//  - Calibration des outils et des repères dans l’espace robotisé
//
//  Savoir reprogrammer / ajuster :
//  - Les frames de prise/dépose et leurs offsets
//  - Les cycles spécifiques (CycleRondelle, CycleEngrenage...)
//
// ******************************************************
// FIN DU README
// ******************************************************
return
.END

.PROGRAM MainP2

.DESCRIPTION

.INPUTS

.VARIABLES

    array TaskRobotRun = [<bool> false, false]
    real Timer

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Boucle principale qui surveille la tâche
//                du robot et la redémarre automatiquement
//                si elle s’arrête plus de 2 secondes.
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

print("Task Main Start")

//initialisation variable
gState=0
Timer = -1.0

TaskRobotSTART()


while (true)
    TaskRobotRun[0]=TaskExists(gTaskRobotName)

//Test si la tâche est arrêtée
    if (TaskRobotRun[0]==false and TaskRobotRun[0]!=TaskRobotRun[1])
        Timer = Clock()
    end


    if (Timer > 0 and Clock()-Timer>2.0)
    //Redemarrage de la tache robot
        Timer = -1.0
        TaskRobotSTART()
    end

    TaskRobotRun[1]=TaskRobotRun[0]

end
    return
.END

.PROGRAM Mouvements

.DESCRIPTION

.INPUTS

.VARIABLES

    int Index, ii, NombreEngr, NbCycle, LotSize, Gamme
    real TimeStart, TimeEnd, CycleTime

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Gère la séquence complète d’assemblage de tous les OFs.
//                Pour chaque OF, lit la gamme correspondante et exécute
//                les étapes de fabrication pour chaque unité du lot.
//                Les opérations sont définies dans gcQueryResultGamme,
//                et exécutées via ExecuteAssembly().
//                Chaque étape est logger dans la DB (dbo.Journal) après exécution.
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

INDEX.OF=0
INDEX.GAMME=0
INDEX.UNITE=0
//Print pour se repérer dans la fenêtre de log.
print(" ")
print(" ")
TimeStart=dateTimeCurrent()
// Remplir le tableau des ordres de fabrication
DBReadOF()
// Boucle OFs
while (INDEX.OF<arraySize(gcQueryResultOF.ROWS))
    LotSize=strToint(gcQueryResultOF.ROWS[INDEX.OF].LotSize)
    Gamme=strToint(gcQueryResultOF.ROWS[INDEX.OF].Gamme)
    DBReadGamme(Gamme) // Lecture de la table Gamme
    INDEX.UNITE = 0
    // Boucle taille de lot
    while (INDEX.UNITE < LotSize)
        INDEX.GAMME=0
        //Boucle Gamme
        while(INDEX.GAMME<arraySize(gcQueryResultGamme.ROWS)) // Boucle sur le nombre de Gammes (Etapes à réaliser)
            ExecuteAssembly(gcQueryResultGamme.ROWS[INDEX.GAMME]) // Execution de l'assemblage
            // DBWriteJournal(StrToInt(gcQueryResultOF.ROWS[INDEX.OF].Id),StrToInt(gcQueryResultOF.ROWS[INDEX.OF].Gamme),StrToInt(gcQueryResultGamme.ROWS[INDEX.GAMME].Phase))
            INDEX.GAMME+=1
        end
        INDEX.UNITE += 1
    end
    INDEX.OF+=1
end
// Renseigne le temps de cycle
TimeEnd=dateTimeCurrent()
CycleTime=TimeStart-TimeEnd
// Envoi des informations pour mettre a jour la table KPI de la DB.
DBWriteKPI(CycleTime)
print("Fin d'assemblage")
gStopFin = TRUE
return



//---------------------EN COURS--------------------
//-----Gestion de pieces deja sur la reglette-----
//
//move(PosReglette)
//InspectionReglette()

//while (NbCycle<gcQueryResultOF.ROWS[0].LotSize)
//  if (gNombreEngr<=3)
//      Index = 3
//      print("Tableau rempli donc Index(Phase) = 3")
//  //lecture nbr dents engrenage correspondant à la phase 3 et 4
//  // send demande pos a la vision avec le Inspect G M en fonction du nbr de dents
//  else
//      Index = 1
//      print("Tableau vide donc Index(Phase) = 1")
//  end

//  for (ii = Index  ; ii < Index+2 ; ii+=1)

//  end
//end
.END

.PROGRAM InitCom

.DESCRIPTION

.INPUTS

.VARIABLES

    string l_sErrorMessage

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Gère la connexion réseau au serveur Matrox
//                et à la base de données SQL Server.
//                Appelle Erreur() si l’un échoue.
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Execution de la connexion avec le serveur Matrox.
print("Connexion Matrox")
if (tcpConnect(gsMatrox))
    print("Client connected", gsMatrox)
else
    print("Erreur connexion", gsMatrox)
    Erreur()
end

// Execution de la connexion avec le serveur SQL.
print("Connexion base de donnee")
dbcDisconnect(gsSqlServer)

if (!dbcConnect(gsSqlServer, l_sErrorMessage))
    print("Erreur connexion", l_sErrorMessage)
    Erreur()
end

return
.END

.PROGRAM InitRob

.DESCRIPTION

.INPUTS

.VARIABLES

    int j

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Initialise le robot avec l'outil P2Cam,
//                affecte la vitesse désirée,désactive
//                les valves, et déplace le robot en
//                position de scan avant démarrage.
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Mise en oeuvre du robot pour qu'il puisse commencer à travailler
print("Initialisation du robot")
UtilInitRobotMan("Tool_MOD_P2Cam", VitesseDefaut) // Affectation du préhenseur Caméra au robot ainsi que la vitesse.
// S'assure que les préhenseurs sont ouvert / ne souffle pas
ioWrite("brasValve1", FALSE)
ioWrite("brasValve2", FALSE)

// Déplacement du robot en position de prise d'image de la palette 1
print("Move position de scan")
move(gcPosScanPalette1)

return
.END

.PROGRAM Init

.DESCRIPTION

.INPUTS

.VARIABLES

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Point d’entrée de l’initialisation générale du système.
//                Ce module orchestre l’appel des sous-programmes de
//                calcul d’origine, initialisation de communication,
//                et de robotique.
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Initialisation global du système.
print("Init")
ComputeOrigins() // Définie les repères des palettes
InitCom() // Initialise la communication Matrox/SQL
InitRob() // Initialise le robot.

gStatusRobot = CTE.STATUS.INITIALIZED
print("Init done.")
return
.END

.PROGRAM Deinit

.DESCRIPTION

.INPUTS

.VARIABLES

    string l_sErrorMessage

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Ferme proprement les connexions réseau utilisées
//                par le système robotisé:
//                - Déconnexion de la communication avec le serveur Matrox
//                - Déconnexion de la communication avec la base de données SQL
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Déconnexion de la communication avec Matrox
if (!tcpDisconnect(gsMatrox))
    print("Erreur déconnexion", gsMatrox)
end

// Déconnexion de la communication avec serveur SQL
if (!dbcDisconnect(gsSqlServer, l_sErrorMessage))
    print("Erreur déconnexion",gsSqlServer, l_sErrorMessage)
end

return
.END

.PROGRAM Erreur

.DESCRIPTION

.INPUTS

.VARIABLES

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : Erreur
// Description  : Gère les erreurs du système.
//                - Réinitialise l’état du robot (gStateRobot = 0)
//                - Définit le statut du robot comme étant en erreur
//                  (gStatusRobot = CTE.STATUS.ERROR)
//                - Ferme toutes les connexions via Deinit()
//                - Arrête toutes les tâches avec taskstop()
//                Ce module permet un arrêt propre.
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Change et met le robot en erreur
gStateRobot = 0
gStatusRobot = CTE.STATUS.ERROR
Deinit() // Execute les déconnexion des serveurs
taskstop() // Met fin a la tache

return
.END

.PROGRAM DBQuery

.DESCRIPTION

.INPUTS

    string Query
    class QueryResult

.VARIABLES

    string l_sErrorMessage
    bool xResult

.RETURN_TYPE bool

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Exécute une requête SQL (SELECT...) sur le serveur défini,
//                vérifie si des résultats sont présents,
//                et retourne TRUE si la table contient au moins une ligne.
//                Gère les erreurs de requête avec un appel de Erreur().
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Execute la requete contenue dans "Query" et renseigne le résultat dans QueryResult
if (dbcQuery(gsSqlServer, Query, QueryResult, l_sErrorMessage))
    print("Query Success")
    // Si le tableau de résultat n'est pas vide alors xResult = TRUE
    if (arraySize(QueryResult.ROWS)>0)
        print(QueryResult.ROWS[0][COL_NAME])
        xResult = TRUE
    else
    // Si le tableau de résultat est vide alors xResult = FALSE
        print("Aucune entrée, table vide")
        xResult = FALSE
    end

else
    // En cas d'erreur sur la requête on arrête le système
    print("Query error",l_sErrorMessage)
    Erreur()
end

return xResult
.END

.PROGRAM DBExecute

.DESCRIPTION

.INPUTS

    string Query

.VARIABLES

    string l_sErrorMessage

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Exécute une commande SQL (INSERT, UPDATE)
//                sur le serveur SQL défini. Affiche un message en
//                cas de succès ou d’erreur sur le Query.
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Execute la requête "Query" mais n'enregistre aucun résultat.
if (dbcExecute(gsSqlServer, Query, l_sErrorMessage))
    print("Execute Success")
else
// Si erreur de Query on print l'erreur
    print("Query error",l_sErrorMessage)
end

return
.END

.PROGRAM DBReadGamme

.DESCRIPTION

.INPUTS

    int GammeID

.VARIABLES

    string ls_Query

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Récupère les données associées à une gamme,
//                ou à toutes les gammes si GammeID = -1.
//                Exécute la requête SQL ls_Query concatenée,
//                puis log les résultats via LogGamme().
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Récuperation des données associés a la gamme
if(GammeID>=0)
    // Réalisation de la requete pour la lecture de la vue "GammeDetaillee" en prenant uniquement les données de la gamme "GammeID"
    ls_Query="SELECT Gamme,Gammes.Nom AS NomGamme,Phase,PosX,PosY,Alpha,Part,Engrenages.Nom AS NomPiece,"
    ls_Query+="Engrenages.Dents,Engrenages.DiamInt,Engrenages.Marquage "
    ls_Query+="FROM dbo.Gammes,dbo.Operations,dbo.Engrenages "
    ls_Query+="WHERE Operations.Gamme=Gammes.Id AND Operations.Part=Engrenages.NumPiece AND Gammes.Id="+GammeID+" "
else
// Si "GammeID"=-1 on prend toutes les données
    ls_Query="SELECT Gamme,Gammes.Nom AS NomGamme,Phase,PosX,PosY,Alpha,Part,Engrenages.Nom AS NomPiece,"
    ls_Query+="Engrenages.Dents,Engrenages.DiamInt,Engrenages.Marquage "
    ls_Query+="FROM dbo.Gammes,dbo.Operations,dbo.Engrenages "
    ls_Query+="WHERE Operations.Gamme=Gammes.Id AND Operations.Part=Engrenages.NumPiece "
end
ls_Query+="ORDER BY Gamme,Phase;"

// On execute la requete "ls_Query" vers notre serveur SQL
DBQuery(ls_Query,gcQueryResultGamme)
// Log de la vue "GammeDetaillee" sur la fenetre de log
LogGamme(gcQueryResultGamme)
return
.END

.PROGRAM DBReadOF

.DESCRIPTION

.INPUTS

.VARIABLES

    string ls_Query

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Lit toutes les entrées de la table OFs via une la requête SQL ls_Query,
//                stocke le résultat dans gcQueryResultOF,log les données,
//                et appel de Erreur() si la requête échoue.
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Réalisation de la requete pour la lecture de la table "OFs"
ls_Query="SELECT * FROM OFs"

// Si erreur lors de l'execution de la requête
if(!DBQuery(ls_Query,gcQueryResultOF))
    print("Erreur lecture OF")
    Erreur()
end

// Log de la table "OFs" sur la fenetre de log
LogOF(gcQueryResultOF)

return
.END

.PROGRAM DBWriteJournal

.DESCRIPTION

.INPUTS

    int OFID, GAMMEID, PHASE

.VARIABLES

    string ls_WriteQuery
    real Temps
    string aaaa, mm, dd, hh, mmm, ss, DATETIME

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Génère un horodatage actuel au format SQL,
//                génère une requête d’insertion via ls_WriteQuery,
//                dans la table Journal avec OFID, GAMMEID et PHASE,
//                puis exécute cette requête via DBExecute().
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Récupère le temps actuel
Temps=DateTimeCurrent()
// Extraction de l'horodatage de "Temps"
UtilTimeExtractArg_(Temps,dd,mm,aaaa,hh,mmm,ss)
// Gènère un horodatage désiré grace à l'extraction via passage par référence
DATETIME=""+aaaa+"-"+mm+"-"+dd+" "+hh+":"+mmm+":"+ss+""
print("Temps:",DATETIME)

// Réalisation de la requete pour l'écriture dans la table "JournalDeTest"
ls_WriteQuery="INSERT INTO JournalDeTest VALUES (1,"+OFID+","+GAMMEID+",1,"+PHASE+",'"+DATETIME+"');"
// Execute la requête
DBExecute(ls_WriteQuery)

return
.END

.PROGRAM DBWriteKPI

.DESCRIPTION

.INPUTS

    real Temps

.VARIABLES

    string ls_WriteQuery, aaaa, mm, dd, hh, mmm, ss, TempsCycle
    class QueryResult
    string ls_CheckQuery, ls_InsertQuery

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Met à jour la table SQL Groupe1KPI contenant les
//                indicateurs de production (KPI) de la cellule robotisée.
//                Si aucune ligne n’existe pour IdStation = 1, une ligne est
//                insérée avec des compteurs à zéro.
//                Puis les compteurs sont incrémentés selon les pièces produites
//                (goupilles, rondelles, engrenages), et l’heure du cycle
//                (Temps1Reglette) est mise à jour au format HH:mm:ss.
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Extraction de l'horodatage de "Temps"
UtilTimeExtractArg_(Temps,dd,mm,aaaa,hh,mmm,ss)
// Gènère un horodatage désiré grace à l'extraction via passage par référence
TempsCycle=""+hh+":"+mmm+":"+ss+""

// Vérifie si une ligne existe
ls_CheckQuery = "SELECT * FROM Groupe1KPI WHERE IdStation = 1;"
// Execute la requête et récupère le résulat
DBQuery(ls_CheckQuery, QueryResult)

// Si aucune ligne trouvée, on initialise
if (arraySize(QueryResult.ROWS) == 0)
    ls_InsertQuery = "INSERT INTO Groupe1KPI VALUES (1,0,0,0,0,0,0,'00:00:00');"
    DBExecute(ls_InsertQuery)
end

// Création de la requette de mise à jour
ls_WriteQuery = "UPDATE Groupe1KPI SET "
ls_WriteQuery += "NombreGoupilles = NombreGoupilles + "+NombreGoupilles+", "
ls_WriteQuery += "NombreRondelles = NombreRondelles + "+NombreRondelles+", "
ls_WriteQuery += "NombreEngrenanges15 = NombreEngrenanges15 + "+NombreEngrenage15+", "
ls_WriteQuery += "NombreEngrenanges18 = NombreEngrenanges18 + "+NombreEngrenage18+", "
ls_WriteQuery += "NombreEngrenanges25 = NombreEngrenanges25 + "+NombreEngrenage25+", "
ls_WriteQuery += "Temps1Reglette = '"+TempsCycle+"' "
ls_WriteQuery += "WHERE IdStation = 1;"
// Execute la requête
DBExecute(ls_WriteQuery)

return
.END

.PROGRAM SendMatrox

.DESCRIPTION

.INPUTS

    string Request

.VARIABLES

    string l_sDataReceived
    real DiamCercle2
    string l_input

.RETURN_TYPE bool

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Envoie une requête au serveur Matrox via TCP,
//                attend une réponse avec un timeout de 10 secondes,
//                interprète cette réponse à l’aide du RsParse (RSVPLib),
//                et vérifie si le résultat de la réponse est "ACK".
//                Gère les erreurs de communication via la fonction Erreur()
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

print("Envoie",Request)
// Envoi la requete "Request" au serveur "gsMatrox" et écris la réponse dans "l_sDataReceived"
if (tcpSendAndWait(gsMatrox,Request,l_sDataReceived,10))
    print("Réponse",l_sDataReceived)
    // Découpe du message recu "l_sDataReceived" pour interpretation
    RsParse(l_sDataReceived)
    print(RsReadReplyResult())
    return RsReadReplyResult() == "ACK" // Si la réponse est "ACK" alors retour
else
    // Mise en erreur si erreur d'envoi de la requete
    print("Erreur d'envoie")
    Erreur()
    return false
end
.END

.PROGRAM InspectionGoup

.DESCRIPTION

.INPUTS

.VARIABLES

    string Request, l_sDataReceived
    int Input
    real DiamCercle2

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Envoie une requête via RsCreateRequest (RSVPLib) à Matrox
//                pour lire la position X/Y de la goupille à partir du système vision.
//                RsClear() vide le buffer RSVP avant la requête.
//                La position est corrigée et stockée dans gcPositionPickGoup.
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Clear le buffer
RsClear()
Request=RsCreateRequest("INSPECT_GOUP") // Creation de la requete

if (SendMatrox(Request)) // Appel de "SendMatrox()" pour l'envoi de la requete
    print("Lecture position goupille")
    gcPositionPickGoup = OriginePalettePrise1+trans(RsReadDouble("PosGoupX"),RsReadDouble("PosGoupY"),-3,0,0,180) // Défini la position de prise en fonction des coordonnées recues via Matrox
else
    Erreur() // Appel du programme "Erreur()" si "!SendMatrox()"
end
return
.END

