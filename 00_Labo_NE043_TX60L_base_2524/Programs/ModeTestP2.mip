.PROGRAM MachineDEtat

.DESCRIPTION

.INPUTS

.VARIABLES

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Boucle principale de la tâche robot.
//                Gère les états INIT et RUN du robot via gState,
//                exécute les sous-programmes Init() et Mouvements(),
//                et réagit à l’arrêt demandé via gStopFin.
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

print("Task Robot Start")

gStatusRobot = 0 // Réinitialise le statut global du robot
gStopFin = FALSE // Passe la demande d'arret a FALSE
gStateRobot=0 // Réinitialise l'etat du robot

// Boucle principale de la tâche robot
while(true)
    switch (gState)

        case CTE.STATE.INIT // Passe l’état local robot à INIT
            gStateRobot=CTE.STATE.INIT // Passe l’état robot à INIT
            Init() // Lance l'initialisation
            gStateRobot=0 //Reset

        case CTE.STATE.RUN
            gStateRobot=CTE.STATE.RUN // Passe l’état robot à RUN
            Mouvements() // Lance l'exécution des mouvements
            if (gStopFin) //Si l'arrêt est demandé
                gStateRobot=0 // Réinitialise l’état robot
                gState=0 // Réinitialise l’état général
                print("Stop")
            end
        //default
          //     print("Erreur état")
    end
    delay(0.05)
end

return
.END

.PROGRAM CMDInit

.DESCRIPTION

.INPUTS

.VARIABLES

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Envoie un ordre d’initialisation au robot
//                en vérifiant que la tâche robot existe et
//                que le robot est bien à l’état IDLE.
//                Attend que la tâche robot prenne en charge l’ordre.
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Vérifie si la tâche robot existe
if (!taskExists(gTaskRobotName))
    print("Erreur la tache robot n'existe pas")
    return
end

// Vérifie que le robot est dans l'état IDLE
if (gStateRobot != 0)
    print("Erreur le robot n'est pas en IDLE")
    return
end

//Envoi de l'ordre d'initialisation
gState=CTE.STATE.INIT


while (gStateRobot==0) //Attente que la tache robot aie vue l'ordre
    delay(0)
end

gState=0

return
.END

.PROGRAM CMDRun

.DESCRIPTION

.INPUTS

.VARIABLES

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Envoie un ordre de démarrage (RUN) au robot.
//                Vérifie que la tâche robot est active, que le robot
//                est en IDLE et bien initialisé avant d'envoyer l'ordre.
//                Attend ensuite que la tâche robot prenne en compte l’ordre.
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Vérifie si la tâche robot existe
if (!taskExists(gTaskRobotName))
    print("Erreur la tache robot n'existe pas")
    return
end

// Vérifie que le robot est dans l'état IDLE
if (gStateRobot != 0)
    print("Erreur le robot n'est pas en IDLE")
    return
end

// Vérifie que le robot a bien été initialisé
if (gStatusRobot != CTE.STATUS.INITIALIZED)
    print("Le robot n'est pas initialisé ou en erreur")
    return
end

//Envoi de l'ordre de run
gState=CTE.STATE.RUN


while (gStateRobot==0) //Attente que la tache robot aie vue l'ordre
    delay(0)
end

gState=0

return
.END

.PROGRAM CMDStop

.DESCRIPTION

.INPUTS

.VARIABLES

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Envoie un ordre d'arrêt au robot en activant le flag gStopFin.
//                Vérifie que la tâche robot est active et que le robot
//                est actuellement en mode RUN avant de lancer l'arrêt.
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Vérifie si la tâche robot existe
if (!taskExists(gTaskRobotName))
    print("Erreur la tache robot n'existe pas")
    return
end


// Vérifie que le robot est en exécution
if (gStateRobot != CTE.STATE.RUN)
    print("Erreur le robot n'est pas en RUN")
    return
end

//Envoi de l'ordre d'arret
gStopFin = TRUE

return
.END

.PROGRAM STARTUP

.DESCRIPTION

.INPUTS

.VARIABLES

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Lance la tâche principale du système via TaskMainSTART().
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

TaskMainSTART()

return

.END

.PROGRAM SHUTDOWN

.DESCRIPTION

.INPUTS

.VARIABLES

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Arrête proprement les tâches principales du système.
//                - Tâche robot via TaskRobotSTOP()
//                - Tâche principale via TaskMainSTOP()
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

TaskRobotSTOP()
TaskMainSTOP()

return
.END

.PROGRAM TaskRobotSTART

.DESCRIPTION

.INPUTS

.VARIABLES

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Vérifie si la tâche robot (MachineDEtat) est déjà active.
//                Si ce n’est pas le cas, elle est lancée.
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Vérifie si la tâche robot n’existe pas déjà
if (!taskExists(gTaskRobotName))
    // Démarre la tâche MachineDEtat() lié à "gTaskRobotName"
    taskExecute MachineDEtat(), gTaskRobotName
end

return
.END

.PROGRAM TaskRobotSTOP

.DESCRIPTION

.INPUTS

.VARIABLES

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Arrête la tâche robot si elle est en cours d'exécution.
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Vérifie si la tâche robot est en cours d’exécution
if (taskExists(gTaskRobotName))
    // Arrête proprement la tâche "gTaskRobotName"
    taskStop(gTaskRobotName)
end

return
.END

.PROGRAM TaskMainSTART

.DESCRIPTION

.INPUTS

.VARIABLES

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Vérifie si la tâche principale (MainP2) est déjà active.
//                Si ce n'est pas le cas, elle est lancée.
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Vérifie si la tâche principale existe
if (!taskExists(gTaskMainName))
    // Démarre la tâche principale MainP2() lié à "gTaskMainName"
    taskExecute MainP2(), gTaskMainName
end

return

.END

.PROGRAM TaskMainSTOP

.DESCRIPTION

.INPUTS

.VARIABLES

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Arrête la tâche principale si elle est en cours d'exécution.
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

// Vérifie si la tâche principale est en exécution
if (taskExists(gTaskMainName))
    // Arrête proprement la tâche principale
    taskStop(gTaskMainName)
end

return
.END

.PROGRAM PriseDeposeEngr

.DESCRIPTION

.INPUTS

    locc Position
    bool Prise

.VARIABLES

    real DecalageZ2 = 30

.RETURN_TYPE none

.BODY
// ******************************************************
// Module       : ProgP2
// Description  : Réalise une prise ou une dépose de rondelle à l'aide
//                du vacuum. Descend à la position cible,
//                active ou désactive le vacuum selon l'action (Prise),
//                puis remonte à des vitesses adaptées.
// Auteur       : Da Silva Lucas
// Date         : 11 Juin 2025
// ******************************************************

ToolChange("Tool_MOD_P2Vacuum") // Selection de l'outil "Tool_MOD_P2Vacuum"
move(Position,DecalageZ2) // Déplacement avec approche
setSpeed(VitesseApproche) // Vitesse d'approche
moves(Position) // Déplacement rectiligne
waitEndMove() // Attends la fin du mouvement
ioWrite("brasValve2", Prise) // Ouvre/ferme préhenseur
delay(1)

// -------3D-------
//if (PartName!="")
//  M3D_AsmObjectToggle(PartName,Index,Prise)
//end

moves(Position,DecalageZ2)// Déplacement rectiligne au dessus de la position
setSpeed(VitesseDefaut)// Vitesse par défaut rétablie
return
.END

